# ==========================================
# GLOBAL CONFIG
# ==========================================
ENV=development

# ==========================================
# WANSOFT - MYSQL SOURCE
# ==========================================
WANSOFT_DB_HOST=
WANSOFT_DB_USER=
WANSOFT_DB_PASSWORD=
WANSOFT_DB_NAME=

# ==========================================
# ZENPUT - MYSQL SOURCE
# ==========================================
ZENPUT_DB_HOST=
ZENPUT_DB_USER=
ZENPUT_DB_PASSWORD=
ZENPUT_DB_NAME=

# ==========================================
# ODOO - XML-RPC API
# ==========================================
# Example:
# ODOO_URL=https://yourcompany.odoo.com
# ODOO_DB_NAME=your-db-name

ODOO_URL=
ODOO_DB_NAME=
ODOO_USER=
ODOO_PASSWORD=

# ==========================================
# ZENPUT API
# ==========================================
ZENPUT_API_TOKEN=

# ==========================================
# WANSOFT SOAP (PER SUBSIDIARY)
# ==========================================
# One variable per subsidiary
# Format: WANSOFT_PWD_<SUBSIDIARY_ID>=

# Example:
# WANSOFT_PWD_5320=
# WANSOFT_PWD_4959=

WANSOFT_PWD_<SUBSIDIARY_ID>=

# ==========================================
# LOCAL PATHS
# ==========================================
XML_DOWNLOAD_DIR=
