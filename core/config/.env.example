# ==========================================
# ENVIRONMENT
# ==========================================
ENV=dev

# ==========================================
# WANSOFT - PROD
# ==========================================
WANSOFT_DB_HOST=
WANSOFT_DB_USER=
WANSOFT_DB_PASSWORD=
WANSOFT_DB_NAME=

# ==========================================
# WANSOFT - DEV
# ==========================================
WANSOFT_DB_HOST_DEV=
WANSOFT_DB_USER_DEV=
WANSOFT_DB_PASSWORD_DEV=
WANSOFT_DB_NAME_DEV=

# ==========================================
# ZENPUT - PROD
# ==========================================
ZENPUT_DB_HOST=
ZENPUT_DB_USER=
ZENPUT_DB_PASSWORD=
ZENPUT_DB_NAME=

# ==========================================
# ZENPUT - DEV
# ==========================================
ZENPUT_DB_HOST_DEV=
ZENPUT_DB_USER_DEV=
ZENPUT_DB_PASSWORD_DEV=
ZENPUT_DB_NAME_DEV=

# ==========================================
# ODOO
# ==========================================
ODOO_URL=
ODOO_DB_NAME=
ODOO_USER=
ODOO_PASSWORD=

# ==========================================
# WANSOFT PASSWORDS
# ==========================================
WANSOFT_PWD_<SUBSIDIARY_ID>=

# ==========================================
# XML DOWNLOAD DIRS
# ==========================================
XML_DOWNLOAD_DIR=
XML_DOWNLOAD_DIR_DEV=

# =========================
# INVENTORY ETL
# =========================

# Scope treated as restaurants sales reference
INVENTORY_ETL_SALES_REFERENCE_SCOPE=restaurantes
INVENTORY_ETL_SALES_REFERENCE_SOURCE=sales_reference

# Scopes that should pass through inventory mapping dictionary
INVENTORY_ETL_SCOPE_INCLUDE=shared_cross_company

# Scopes that should go directly to backlog
INVENTORY_ETL_SCOPE_BACKLOG=bodegon,empanadas,bodegon_candidate,empanadas_candidate,review_scope

# =========================
# INVENTORY NOT_FOUND ANALYZER
# =========================

# Backlog bucket to analyze
INVENTORY_NOT_FOUND_BUCKET=not_found

# Scopes to include in the analyzer
INVENTORY_SCOPE_INCLUDE=shared_cross_company,review_scope

# Scopes to exclude in the analyzer
INVENTORY_SCOPE_EXCLUDE=bodegon,empanadas,restaurantes

# Export CSV?
INVENTORY_NOT_FOUND_EXPORT=true

# Output file
INVENTORY_NOT_FOUND_EXPORT_FILE=inventory_not_found_analysis.csv